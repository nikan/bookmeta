{
    "name": "nikan/bookmeta",
    "description": "Book metadata extractor for biblionet.gr, queried by ISBN.",
    "license": "GPL-2.0-or-later",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "BookMeta\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BookMeta\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    }
}
